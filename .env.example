# AutoForge Environment Configuration

# Service Ports & Hosts
API_HOST=0.0.0.0
API_PORT=8000
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8001
STREAMLIT_PORT=8501
MLFLOW_PORT=5000

# Service URLs (for container-to-container / local communication)
API_URL=http://localhost:8000
INFERENCE_URL=http://localhost:8001
MLFLOW_TRACKING_URI=http://localhost:5000

# Storage & Paths
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
SQLITE_DB_PATH=./artifacts/autoforge.db

# Model Training & Search Defaults
DEFAULT_TIME_BUDGET_SECS=120
OPTUNA_TRIALS=50

# Drift Detection Thresholds
DRIFT_CHECK_INTERVAL_SECONDS=300
DRIFT_SHARE_THRESHOLD=0.30
DRIFT_PSI_THRESHOLD=0.20

# Logging
LOG_LEVEL=INFO
